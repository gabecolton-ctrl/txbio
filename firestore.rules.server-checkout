rules_version = '2';
// Rules for AFTER the server checkout is on (js/site-config.js
// USE_SERVER_CHECKOUT = true). Publish these in Firebase only then.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'gabecolton@gmail.com';
    }

    // Lowercased login email of the signed-in user (store credit is keyed by it).
    function myEmail() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Each user's cart — only they can read/write it.
    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Each user's profile info (name, org, address) — only they can write it;
    // they and the admin (Customers page) can read it.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Orders — placed only by the server checkout (functions/), which is not
    // subject to these rules. Buyers read their own; only the admin updates
    // them (status, tracking, cancellations, affiliate credit bookkeeping).
    match /orders/{orderId} {
      allow create: if false;
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isAdmin() || (
        // A buyer may cancel their own order while it's still pending
        // (not yet confirmed or paid). The admin page then returns stock
        // and any store credit (admin-orders.html).
        signedIn()
        && request.auth.uid == resource.data.userId
        && resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledAt'])
        && request.resource.data.cancelledBy == 'customer'
      );
      allow delete: if false;
    }

    // Stock counts — anyone signed in can read them; only the admin (and the
    // server checkout) can change them.
    match /inventory/{productSlug} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Promo codes — anyone signed in can read (to preview a code at
    // checkout); only the admin (and the server checkout) can change them.
    match /promoCodes/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // BOGO eligibility per product — public (the catalog shows BOGO badges to
    // signed-out visitors too); only the admin edits it.
    match /bogoProducts/{productSlug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings (e.g. settings/bankTransfer with payment details).
    // Signed-in buyers can read them at checkout; only the admin can edit.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Store credit, keyed by lowercased login email. The owner can read it;
    // only the admin (and the server checkout, when credit is spent) can
    // change it.
    match /credits/{email} {
      allow read: if isAdmin() || myEmail() == email;
      allow write: if isAdmin();

      match /entries/{entryId} {
        allow read: if isAdmin() || myEmail() == email;
        allow write: if isAdmin();
      }
    }

    // "At cost" family pricing (js/at-cost.js, admin-at-cost.html).
    // Costs are private: the admin, and the emails listed on an at-cost code
    // (mirrored into atCostMembers/{email}) so their checkout can price at cost.
    function isAtCostMember() {
      return signedIn() && exists(/databases/$(database)/documents/atCostMembers/$(myEmail()));
    }
    match /costs/{unitSlug} {
      allow read: if isAdmin() || isAtCostMember();
      allow write: if isAdmin();
    }
    // A code is readable only by the emails it lists; for anyone else it
    // looks like it doesn't exist.
    match /atCostCodes/{code} {
      allow read: if isAdmin() || (signedIn() && resource != null && myEmail() in resource.data.emails);
      allow write: if isAdmin();
    }
    match /atCostMembers/{email} {
      allow read: if isAdmin() || myEmail() == email;
      allow write: if isAdmin();
    }

    // Visit counts for the admin Traffic page (js/analytics.js): one summary
    // per day, no personal data. Anyone may add exactly one page view at a
    // time; only the admin can read them.
    function trafficShape() {
      return request.resource.data.keys().hasOnly(['views', 'visitors', 'newVisitors', 'sessions', 'signedInViews', 'pages', 'refs', 'sources', 'landing', 'devices', 'updatedAt'])
        && request.resource.data.get('pages', {}).size() <= 400
        && request.resource.data.get('refs', {}).size() <= 300
        && request.resource.data.get('sources', {}).size() <= 300
        && request.resource.data.get('landing', {}).size() <= 400
        && request.resource.data.get('devices', {}).size() <= 4;
    }
    match /traffic/{day} {
      allow read: if isAdmin();
      allow create: if day.matches('^20[0-9][0-9]-[01][0-9]-[0-3][0-9]$') && trafficShape() && request.resource.data.views == 1;
      allow update: if trafficShape() && request.resource.data.views == resource.data.views + 1;
      allow delete: if isAdmin();
    }

    // Supplier shipments on their way (Admin → Incoming). Admin only; the
    // UPS tracker uses the service account, which bypasses these rules.
    match /incoming/{id} {
      allow read, write: if isAdmin();
    }

    // Visits that arrived through a referral link (?code=CODE, js/referral.js).
    // Anyone may add one visit to an existing promo code's counter; only the
    // admin and that code's affiliate can read it (affiliate dashboard).
    function refTrafficShape() {
      return request.resource.data.keys().hasOnly(['visits', 'visitors', 'days', 'updatedAt'])
        && request.resource.data.visits is int
        && request.resource.data.get('visitors', 0) is int
        && request.resource.data.get('days', {}).size() <= 1000;
    }
    match /refTraffic/{code} {
      allow read: if isAdmin()
        || (signedIn() && get(/databases/$(database)/documents/promoCodes/$(code)).data.get('affiliateEmail', '') == myEmail());
      allow create: if exists(/databases/$(database)/documents/promoCodes/$(code))
        && refTrafficShape()
        && request.resource.data.visits == 1
        && request.resource.data.get('visitors', 0) <= 1;
      allow update: if refTrafficShape()
        && request.resource.data.visits == resource.data.visits + 1
        && request.resource.data.get('visitors', 0) >= resource.data.get('visitors', 0)
        && request.resource.data.get('visitors', 0) <= resource.data.get('visitors', 0) + 1;
      allow delete: if isAdmin();
    }
  }
}
