rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'gabecolton@gmail.com';
    }

    // Lowercased login email of the signed-in user (store credit is keyed by it).
    function myEmail() {
      return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    // Each user's cart — only they can read/write it.
    match /carts/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Each user's profile info (name, org, address) — only they can write it;
    // they and the admin (Customers page) can read it.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Orders — a user can create an order for themselves and read only their
    // own orders. Orders are immutable for buyers; only the admin can update
    // them (status, tracking, cancellations, affiliate credit bookkeeping).
    match /orders/{orderId} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow read: if signedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Stock counts — anyone signed in can read them. Checkout runs in the
    // buyer's browser, so buyers may LOWER a count (never raise it, never
    // below zero, nothing else changed). Only the admin can set counts or
    // put stock back.
    match /inventory/{productSlug} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'updatedAt'])
        && request.resource.data.qty is int
        && request.resource.data.qty >= 0
        && request.resource.data.qty <= resource.data.qty;
    }

    // Promo codes — anyone signed in can read (to validate at checkout); only
    // the admin can create, edit, or delete them. Checkout runs in the buyer's
    // browser, so a buyer may record one use: timesUsed up by exactly 1 and
    // totalDiscounted up, nothing else changed.
    match /promoCodes/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timesUsed', 'totalDiscounted'])
        && request.resource.data.timesUsed == resource.data.get('timesUsed', 0) + 1
        && request.resource.data.totalDiscounted >= resource.data.get('totalDiscounted', 0);
    }

    // BOGO eligibility per product — read by checkout, edited by the admin.
    match /bogoProducts/{productSlug} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Site settings (e.g. settings/bankTransfer with payment details).
    // Signed-in buyers can read them at checkout; only the admin can edit.
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Store credit, keyed by lowercased login email. The owner can read it
    // and can only SPEND it: balance goes down by exactly what spent goes
    // up, never below zero. Only the admin can add, reverse, or refund.
    match /credits/{email} {
      allow read: if isAdmin() || myEmail() == email;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        myEmail() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balanceCents', 'spentCents', 'updatedAt'])
        && request.resource.data.balanceCents is int
        && request.resource.data.spentCents is int
        && request.resource.data.spentCents > resource.data.spentCents
        && request.resource.data.balanceCents == resource.data.balanceCents - (request.resource.data.spentCents - resource.data.spentCents)
        && request.resource.data.balanceCents >= 0
      );

      // Credit history. The owner can read it and add only "spent" entries
      // (written together with an order); everything else is admin-only.
      match /entries/{entryId} {
        allow read: if isAdmin() || myEmail() == email;
        allow create: if isAdmin() || (myEmail() == email && request.resource.data.type == 'spent');
        allow update, delete: if isAdmin();
      }
    }
  }
}
