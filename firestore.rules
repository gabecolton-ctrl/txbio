rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's cart — only they can read/write it.
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Each user's profile info (name, org, address) — only they can read/write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders — a user can create an order for themselves, and read only
    // orders where they are the owner. Orders are not editable or
    // deletable once created (immutable order history), except by the
    // admin account (for backorder/fulfillment status updates).
    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.userId || request.auth.token.email == 'gabecolton@gmail.com');
      allow update: if request.auth != null && request.auth.token.email == 'gabecolton@gmail.com';
      allow delete: if false;
    }

    // Inventory/stock counts — anyone signed in can read (to check stock
    // at checkout), but only the admin account can write (update counts).
    match /inventory/{productSlug} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'gabecolton@gmail.com';
    }
  }
}
